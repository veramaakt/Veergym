# Veergym — geheime instellingen.
#
# Dit is een VOORBEELD. Het kopieerscript maakt in je app-map (Veergym - app)
# een bestand ".env" aan op basis hiervan. Vul daar je echte waarden in.
# Dat .env-bestand gaat nooit naar GitHub en wordt nooit overschreven.

# Wachtwoord om in te loggen in de app (telefoon en desktop). Verplicht.
APP_PASSWORD=

# Geheime sleutel voor inlog-tokens. Mag leeg blijven: dan maakt de app er zelf
# een aan in data/secret_key. Vul hem wel in als je later naar de cloud gaat.
SECRET_KEY=

# Hoe lang je ingelogd blijft (dagen).
TOKEN_DAYS=180

# Optioneel: andere plek voor je data (standaard: map "data" in de app-map).
# VEERGYM_DATA_DIR=

# Optioneel: andere database (later, bij cloudhosting), bijv. Postgres.
# DATABASE_URL=

# --- Fase 2: koppelingen (nog niet in gebruik) ---

# Claude API voor "Schat macro's" bij eten (aparte API-rekening).
ANTHROPIC_API_KEY=

# MyFitt-weegschaal, als die een eigen koppeling blijkt te hebben.
SCALE_API_KEY=

# Galaxy Watch / Samsung Health, als er een sleutel nodig blijkt te zijn.
# (De koppeling loopt normaal via Health Connect op je telefoon, zonder sleutel.)
WATCH_API_KEY=
